{
  "name": "@inandu-solutions/grid-vue",
  "version": "0.5.3",
  "description": "Standalone Vue 3 data grid: sorting, free-text and per-column filtering, grouping, pagination, CSV/Excel (.xls)/PDF export and print, i18n (5 languages) and theming, with a deliberately small dependency footprint. The Vue port of @inandu-solutions/grid-angular.",
  "keywords": [
    "vue",
    "vue3",
    "vue-grid",
    "vue-datagrid",
    "vue-table",
    "vue-component",
    "composable",
    "data-grid",
    "datagrid",
    "grid",
    "table",
    "data-table",
    "virtual-scroll",
    "pagination",
    "grouping",
    "inline-editing",
    "csv-export",
    "excel-export",
    "i18n",
    "headless"
  ],
  "license": "MIT",
  "author": {
    "name": "Inandu SAS",
    "url": "https://www.inandu.com/"
  },
  "homepage": "https://github.com/inandusolutions/inandu-grid-vue#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inandusolutions/inandu-grid-vue.git"
  },
  "bugs": {
    "url": "https://github.com/inandusolutions/inandu-grid-vue/issues"
  },
  "type": "module",
  "main": "./dist/inandu-grid-vue.cjs",
  "module": "./dist/inandu-grid-vue.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/inandu-grid-vue.js",
      "require": "./dist/inandu-grid-vue.cjs"
    },
    "./style.css": {
      "default": "./dist/style.css"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "vite build && node -e \"require('fs').copyFileSync('src/styles/inandu-grid.css','dist/style.css')\"",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test --project=chromium",
    "e2e:all": "playwright test",
    "api:check": "node scripts/api-snapshot.mjs",
    "api:update": "node scripts/api-snapshot.mjs --update",
    "check:css-sync": "node scripts/check-css-sync.mjs",
    "check:package": "node scripts/check-package.mjs",
    "smoke:package": "node scripts/smoke-package.mjs",
    "check:dts": "tsc --noEmit --skipLibCheck false --strict --target es2022 --module esnext --moduleResolution bundler dist/index.d.ts"
  },
  "peerDependencies": {
    "jspdf": "^4.2.1",
    "vue": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "jspdf": {
      "optional": true
    }
  },
  "dependencies": {
    "@inandu-solutions/grid-core": "^0.1.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.1",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^31.0.1",
    "jspdf": "^4.2.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "editorconfig": {
      "minimatch": "^11.0.1"
    },
    "glob": {
      "minimatch": "^11.0.1"
    }
  }
}
