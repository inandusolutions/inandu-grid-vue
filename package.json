{
  "name": "@inandu-solutions/grid-vue",
  "version": "0.2.2",
  "description": "Standalone Vue 3 data grid: sorting, free-text and per-column filtering, grouping, pagination, CSV/Excel (.xls)/PDF export and print, i18n (5 languages) and theming, with a deliberately small dependency footprint. The Vue port of @inandu-solutions/grid-angular.",
  "keywords": [
    "vue",
    "vue3",
    "vue-grid",
    "vue-datagrid",
    "vue-table",
    "vue-component",
    "composable",
    "data-grid",
    "datagrid",
    "grid",
    "table",
    "data-table",
    "virtual-scroll",
    "pagination",
    "grouping",
    "inline-editing",
    "csv-export",
    "excel-export",
    "i18n",
    "headless"
  ],
  "license": "MIT",
  "author": {
    "name": "Inandu SAS",
    "url": "https://www.inandu.com/"
  },
  "homepage": "https://github.com/inandusolutions/inandu-grid-vue#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inandusolutions/inandu-grid-vue.git"
  },
  "bugs": {
    "url": "https://github.com/inandusolutions/inandu-grid-vue/issues"
  },
  "type": "module",
  "main": "./dist/inandu-grid-vue.cjs",
  "module": "./dist/inandu-grid-vue.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/inandu-grid-vue.js",
      "require": "./dist/inandu-grid-vue.cjs"
    },
    "./style.css": {
      "default": "./dist/style.css"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "vite build && node -e \"require('fs').copyFileSync('src/styles/inandu-grid.css','dist/style.css')\"",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "jspdf": "^4.2.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.13"
  }
}
